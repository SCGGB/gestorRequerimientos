# Oracle
ORACLE_USER=app_req
ORACLE_PASSWORD=change_me
ORACLE_DSN=oracle:1521/FREEPDB1
# Autonomous DB (wallet montado como volumen, nunca en la imagen)
ORACLE_WALLET_DIR=
# Almacenamiento: local | s3 | oci
STORAGE_BACKEND=local
# Autenticacion: local_jwt | oidc  (ver ADR-003)
AUTH_PROVIDER=local_jwt
JWT_SECRET=change_me
# IA opcional: none | <proveedor>
AI_PROVIDER=none
# Object store S3 de desarrollo (RustFS; solo con: docker compose --profile objectstore up)
# Ver doc/architecture/adr/006-almacenamiento-objetos-dev.md
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
