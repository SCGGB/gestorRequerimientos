# Oracle
ORACLE_USER=app_req
ORACLE_PASSWORD=change_me
ORACLE_DSN=oracle:1521/FREEPDB1
# Autonomous DB (wallet montado como volumen, nunca en la imagen)
ORACLE_WALLET_DIR=
# Almacenamiento: local | s3 | oci
STORAGE_BACKEND=local
# Autenticacion: local_jwt | oidc  (ver ADR-003)
AUTH_PROVIDER=local_jwt
# SECRETO: solo en .env, nunca en imagenes ni en git.
JWT_SECRET=change_me
JWT_TTL_HOURS=8
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_FAILED_ATTEMPTS=5
# Semilla del usuario ADMIN inicial (migracion 0004)
# SECRETO: SEED_ADMIN_PASSWORD solo en .env, nunca en imagenes ni en git.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me
SEED_ADMIN_NOMBRE=Administrador
# IA opcional: none | <proveedor>
AI_PROVIDER=none
# Generacion de documentos (SPEC-007)
TEMPLATES_DIR=/app/templates
DOCUMENT_TEMPLATE_VERSION=v1
LIBREOFFICE_BINARY=soffice
DOCUMENT_GENERATION_TIMEOUT_SECONDS=60
DOCUMENT_MAX_BYTES=25000000
# Object store S3 de desarrollo (RustFS; solo con: docker compose --profile objectstore up)
# Ver doc/architecture/adr/006-almacenamiento-objetos-dev.md
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
